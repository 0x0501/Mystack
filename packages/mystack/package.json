{
	"name": "@0x0501/mystack",
	"version": "0.1.2",
	"description": "Create a configured TanStack Start application",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0x0501/mystack.git",
		"directory": "packages/mystack"
	},
	"homepage": "https://github.com/0x0501/mystack/tree/main/packages/mystack#readme",
	"bugs": {
		"url": "https://github.com/0x0501/mystack/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"bin": {
		"mystack": "dist/cli.js"
	},
	"files": [
		"dist",
		"template",
		"assets",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"template:prepare": "bun scripts/prepare-template.ts",
		"prepack": "bun run build && bun run template:prepare",
		"test": "bun run --cwd ../.. test:cli",
		"test:generated": "bun scripts/verify-generated.ts",
		"test:packed": "bun scripts/verify-packed.ts"
	},
	"dependencies": {
		"@biomejs/biome": "2.5.15",
		"@clack/prompts": "^1.8.1",
		"@tanstack/router-generator": "1.167.38"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2"
	}
}
