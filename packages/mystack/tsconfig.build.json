{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"rootDir": "src",
		"outDir": "dist",
		"rewriteRelativeImportExtensions": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noEmitOnError": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
